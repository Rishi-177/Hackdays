# CarbonPilot Combined Backend Environment Configuration

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Optional Supabase Connection (If omitted, uses local SQLite / in-memory database)
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Storage Mode: "sqlite" or "memory" or "supabase"
DB_MODE=sqlite
DATABASE_FILE=carbonpilot.db
